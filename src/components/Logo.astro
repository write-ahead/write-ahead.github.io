---
// Write-Ahead mark: a hand-drawn append-only log. Three cells of the log
// tape hold written entries; a bold arrow runs *ahead* of them — the log is
// written before the data page. The teal dot is the last committed record
// (the LSN). Colors come from CSS tokens, so it follows light/dark. Draws
// itself in on load.
interface Props {
  height?: number;
  class?: string;
}
const { height = 42, class: className = '' } = Astro.props;
const width = Math.round((height * 54) / 44);
---

<svg
  class:list={['wa-logo', className]}
  width={width}
  height={height}
  viewBox="0 0 54 44"
  fill="none"
  role="img"
  aria-label="Write-Ahead logo — an append-only log with a write-ahead arrow"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <!-- log tape (drawn twice = sketchy) -->
  <rect
    class="wa-tape"
    x="3" y="13" width="34" height="18" rx="3"
    stroke="var(--ink)" stroke-width="2.6" fill="var(--panel)"
  />
  <rect
    class="wa-tape2"
    x="3.7" y="13.7" width="32.6" height="16.6" rx="3"
    stroke="var(--ink)" stroke-width="1.2" opacity="0"
  />

  <!-- cell dividers -->
  <g class="wa-ticks" stroke="var(--ink-soft)" stroke-width="1.8">
    <line x1="12" y1="13" x2="12" y2="31" />
    <line x1="20" y1="13" x2="20" y2="31" />
    <line x1="28" y1="13" x2="28" y2="31" />
  </g>

  <!-- written entries -->
  <g class="wa-rows" stroke="var(--ink-soft)" stroke-width="2" opacity="0">
    <line x1="6" y1="22" x2="9.5" y2="22" />
    <line x1="14" y1="22" x2="17.5" y2="22" />
    <line x1="22" y1="22" x2="25.5" y2="22" />
  </g>

  <!-- the write-ahead arrow: the log runs ahead of the data -->
  <path class="wa-arrow" d="M37 22 L50 22" stroke="var(--accent)" stroke-width="2.8" />
  <path class="wa-head" d="M45 17 L51 22 L45 27" stroke="var(--accent)" stroke-width="2.8" fill="none" />

  <!-- committed record (LSN) -->
  <circle class="wa-dot" cx="32" cy="22" r="2.6" fill="var(--accent2)" stroke="var(--panel)" stroke-width="1" />
</svg>

<style>
  .wa-tape {
    stroke-dasharray: 150; stroke-dashoffset: 150;
    animation: wa-draw 0.9s ease forwards;
  }
  .wa-tape2 { animation: wa-fade 0.5s ease 0.6s forwards; }
  .wa-ticks {
    stroke-dasharray: 20; stroke-dashoffset: 20;
    animation: wa-draw 0.5s ease 0.45s forwards;
  }
  .wa-rows { animation: wa-fade 0.5s ease 0.7s forwards; }
  .wa-arrow {
    stroke-dasharray: 14; stroke-dashoffset: 14;
    animation: wa-draw 0.4s ease 0.75s forwards;
  }
  .wa-head {
    transform-box: fill-box; transform-origin: center; transform: scale(0);
    animation: wa-pop 0.4s cubic-bezier(0.3, 1.6, 0.5, 1) 0.95s both;
  }
  .wa-dot {
    transform-box: fill-box; transform-origin: center; transform: scale(0);
    animation: wa-pop 0.4s cubic-bezier(0.3, 1.6, 0.5, 1) 1.05s both;
  }

  @keyframes wa-draw { to { stroke-dashoffset: 0; } }
  @keyframes wa-fade { to { opacity: 0.5; } }
  @keyframes wa-pop { to { transform: scale(1); } }

  /* hover: the committed record blinks like a flushing cursor */
  :global(.brand):hover .wa-dot,
  .wa-logo:hover .wa-dot { animation: wa-blink 1.1s steps(1) infinite; }
  @keyframes wa-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.25; } }

  @media (prefers-reduced-motion: reduce) {
    .wa-tape { stroke-dashoffset: 0; animation: none; }
    .wa-tape2 { opacity: 0.5; animation: none; }
    .wa-ticks { stroke-dashoffset: 0; animation: none; }
    .wa-rows { opacity: 0.5; animation: none; }
    .wa-arrow { stroke-dashoffset: 0; animation: none; }
    .wa-head { transform: scale(1); animation: none; }
    .wa-dot { transform: scale(1); animation: none; }
  }
</style>
