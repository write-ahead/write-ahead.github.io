---
import BaseLayout from './BaseLayout.astro';
import { slugifyTag, getNeighbors, getChapterNumber } from '../utils/chapters';

interface Props {
  id: string;
  frontmatter: {
    title: string;
    description: string;
    pubDate: Date;
    part?: string;
    tags?: string[];
  };
}
const { id, frontmatter } = Astro.props;

const number = await getChapterNumber(id);
const { prev, next } = await getNeighbors(id);

const date = new Date(frontmatter.pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <article data-pagefind-body>
    <a class="back-link" href="/" data-pagefind-ignore>← the whole book</a>
    <div class="eyebrow" style="margin-top:14px;">
      {number ? `Chapter ${number}` : 'Draft'}
      <span class="dot">·</span> {frontmatter.part ?? 'Internals'}
    </div>
    <h1>{frontmatter.title}</h1>
    <p class="byline">{date}</p>
    {frontmatter.tags?.length ? (
      <div class="post-tags">
        {frontmatter.tags.map((t) => (
          <a class="tag tag-link" href={`/tags/${slugifyTag(t)}/`}>#{t}</a>
        ))}
      </div>
    ) : null}
    <div class="prose">
      <slot />
    </div>

    {(prev || next) && (
      <nav class="chapter-nav" data-pagefind-ignore>
        {prev && (
          <a class="prev" href={`/chapters/${prev.id}`}>
            <div class="dir">← previous</div>
            <div class="ttl">{prev.data.title}</div>
          </a>
        )}
        {next && (
          <a class="next" href={`/chapters/${next.id}`}>
            <div class="dir">next →</div>
            <div class="ttl">{next.data.title}</div>
          </a>
        )}
      </nav>
    )}
  </article>
</BaseLayout>
