---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Tuple Not Found" description="No row matches that key.">
  <section class="nf">
    <div class="nf-code">404</div>
    <h1>Tuple not found.</h1>
    <p class="lede">
      We scanned the page, walked the index, and came back empty-handed — there's no row
      at this key. The slot points nowhere.
    </p>

    <figure class="nf-fig" data-sketch-frame>
      <svg viewBox="0 0 440 210" role="img"
           aria-label="A database page with a slot directory; one slot's pointer dangles into empty space.">
        <!-- page -->
        <rect x="24" y="20" width="392" height="170" rx="6" fill="var(--panel)"
              stroke="var(--ink)" stroke-width="2.4"/>
        <!-- header -->
        <rect x="34" y="30" width="372" height="26" rx="4" fill="var(--accent)" opacity="0.9"/>
        <text x="46" y="48" font-family="var(--font-mono)" font-size="13" fill="var(--panel)" font-weight="700">PAGE 0 · HEADER</text>

        <!-- slot directory -->
        <g>
          <rect x="40" y="70" width="30" height="22" fill="var(--accent)" stroke="var(--ink)" stroke-width="1.6"/>
          <rect x="78" y="70" width="30" height="22" fill="var(--accent)" stroke="var(--ink)" stroke-width="1.6"/>
          <rect x="116" y="70" width="30" height="22" fill="none" stroke="var(--rollback)" stroke-width="2" stroke-dasharray="4 3"/>
          <text x="55" y="86" text-anchor="middle" font-family="var(--font-hand)" font-size="13" fill="var(--panel)" font-weight="700">0</text>
          <text x="93" y="86" text-anchor="middle" font-family="var(--font-hand)" font-size="13" fill="var(--panel)" font-weight="700">1</text>
          <text x="131" y="86" text-anchor="middle" font-family="var(--font-hand)" font-size="13" fill="var(--rollback)" font-weight="700">?</text>
        </g>

        <!-- committed rows -->
        <rect x="40" y="150" width="360" height="26" fill="var(--accent2)" opacity="0.55" stroke="var(--accent2)" stroke-width="1.6"/>
        <rect x="40" y="120" width="360" height="26" fill="var(--accent2)" opacity="0.55" stroke="var(--accent2)" stroke-width="1.6"/>

        <!-- the dangling pointer -->
        <path class="dangle" d="M131 92 Q 150 110 150 132" stroke="var(--rollback)" stroke-width="2" fill="none" stroke-dasharray="4 4"/>
        <text x="186" y="112" font-family="var(--font-hand)" font-size="15" fill="var(--rollback)">→ points nowhere</text>
      </svg>
    </figure>

    <a class="nf-btn" href="/">← back to the log</a>
  </section>

  <style>
    .nf { text-align: center; padding-top: 8px; }
    .nf-code {
      font-family: var(--font-display);
      font-size: clamp(4.5rem, 20vw, 8rem);
      line-height: 0.9;
      color: var(--accent);
      transform: rotate(-2deg);
    }
    .nf h1 { margin: 0.1em 0 0.3em; }
    .nf .lede { max-width: 44ch; margin-inline: auto; }
    .nf-fig {
      position: relative;
      background: var(--panel);
      border-radius: 12px;
      padding: 16px 14px 10px;
      margin: 1.8em auto 1.6em;
      max-width: 440px;
      box-shadow: 0 12px 30px -24px rgba(0, 0, 0, 0.55);
    }
    .nf-fig svg { display: block; width: 100%; height: auto; }
    .dangle {
      stroke-dasharray: 4 4;
      animation: nf-wiggle 2.2s ease-in-out infinite;
    }
    @keyframes nf-wiggle {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(4px); }
    }
    .nf-btn {
      display: inline-block;
      font-family: var(--font-hand); font-weight: 600;
      font-size: 1.15rem;
      color: var(--accent);
      background: transparent;
      border: 1.8px dashed var(--accent);
      border-radius: 22px;
      padding: 7px 20px;
      text-decoration: none;
      transform: rotate(-0.8deg);
      transition: background 0.15s ease, color 0.15s ease;
    }
    .nf-btn:hover,
    .nf-btn:focus-visible { background: var(--accent); color: var(--panel); outline: none; }
    @media (prefers-reduced-motion: reduce) {
      .dangle { animation: none; }
    }
  </style>
</BaseLayout>
