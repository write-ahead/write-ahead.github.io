---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getParts, chapterHref } from '../utils/chapters';

const parts = await getParts(true); // posted + "coming soon" (drafts excluded)
const fmt = (d: Date) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title="Write-Ahead">
  <div class="eyebrow">Database internals <span class="dot">·</span> from the first byte up</div>
  <h1>How databases <em>actually</em> work, drawn by hand.</h1>
  <p class="lede">
    A slow walk through the inside of a database — pages, trees, logs, locks — rebuilt
    from sketches and small animations instead of walls of code.
  </p>

  {parts.length === 0 ? (
    <p class="byline">The first entry is being written — check back soon.</p>
  ) : (
    parts.map((part) => (
      <section class="part">
        <div class="part-label">{part.name}</div>
        <ul class="toc">
          {part.chapters.map((ch) =>
            ch.data.status === 'soon' ? (
              <li class="soon-entry">
                <div class="soon-entry-rule" aria-hidden="true">
                  <span class="soon-entry-mark"></span>
                </div>
                <div class="soon-entry-body">
                  <div class="soon-entry-tag">pending · coming soon</div>
                  <h3 class="soon-entry-title">{ch.data.title}</h3>
                  <p class="soon-entry-desc">{ch.data.description}</p>
                </div>
              </li>
            ) : (
              <li class="toc-item" data-sketch-frame>
                <div class="toc-body">
                  <a class="toc-title" href={chapterHref(ch)}>{ch.data.title}</a>
                  <div class="meta">{fmt(ch.data.pubDate)}</div>
                  <p>{ch.data.description}</p>
                </div>
              </li>
            )
          )}
        </ul>
      </section>
    ))
  )}
</BaseLayout>
