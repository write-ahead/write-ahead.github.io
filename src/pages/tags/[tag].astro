---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, type TagGroup } from '../../utils/chapters';

export async function getStaticPaths() {
  const tags = await getAllTags();
  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: { tag },
  }));
}

interface Props {
  tag: TagGroup;
}
const { tag } = Astro.props;
const fmt = (d: Date) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={`#${tag.label}`} description={`Chapters about ${tag.label}.`}>
  <a class="back-link" href="/tags/">← all topics</a>
  <div class="eyebrow" style="margin-top:14px;">topic</div>
  <h1>#{tag.label}</h1>
  <p class="lede">
    {tag.chapters.length} chapter{tag.chapters.length === 1 ? '' : 's'} about “{tag.label}”.
  </p>

  <ul class="post-list">
    {tag.chapters.map((ch) => (
      <li class="post-card" data-sketch-frame>
        <a class="card-title" href={`/chapters/${ch.id}`}>{ch.data.title}</a>
        <div class="meta">{fmt(ch.data.pubDate)}</div>
        <p>{ch.data.description}</p>
      </li>
    ))}
  </ul>
</BaseLayout>
